# TappaScore Backend Environment Configuration Example
# Copy this file to .env and fill in your local values

PORT=
NODE_ENV=
MONGODB_URI=
JWT_SECRET=
# Note: OWNER_BOOTSTRAP_* environment variables are ONLY used for initial owner bootstrap.
# Once an Owner account exists in the database, changing these values will NOT overwrite or affect the existing owner's credentials.
OWNER_BOOTSTRAP_NAME=
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=
